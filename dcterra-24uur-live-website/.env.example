# Kopieer dit bestand naar .env en pas de waarden aan.
PORT=3000
APP_URL=http://localhost:3000
# Vul een uniek, sterk wachtwoord in voordat je /crew gebruikt.
ADMIN_PASSWORD=
# Betalingen staan bewust uit totdat Wensstichting Drenthe akkoord heeft gegeven.
PAYMENTS_ENABLED=false
# API-sleutel van het door Wensstichting Drenthe goedgekeurde Mollie-account.
MOLLIE_API_KEY=
# Optioneel: SQLite-data op een persistent volume (geen serverless opslag).
DB_PATH=./data/site.sqlite
